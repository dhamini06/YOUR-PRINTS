# ==============================================================================
# YOUR-PRINTS: Digital Footprint Intelligence - Environment Configuration
# ==============================================================================
# COPY THIS FILE TO .env FOR LOCAL DEVELOPMENT.
# NEVER COMMIT REAL KEYS OR SECRETS TO VERSION CONTROL.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (PostgreSQL 16)
DB_USER=yourprints_user
DB_PASSWORD=yourprints_insecure_dev_password
DB_NAME=yourprints_db
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# Investigation Guardrails
INVESTIGATION_TIMEOUT_SECONDS=15
PER_PROVIDER_TIMEOUT_SECONDS=5.0
MAX_CONCURRENT_INVESTIGATIONS=10
INVESTIGATION_TTL_HOURS=48

# Security & Bot Mitigation
# Cloudflare Turnstile (Optional in local dev mode)
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional Provider API Credentials (Leave empty for zero-cost mode)
# GitHub Personal Access Token (Increases rate limit from 60 to 5,000 req/hr)
GITHUB_TOKEN=
# Have I Been Pwned API Key (Optional commercial key)
HIBP_API_KEY=
